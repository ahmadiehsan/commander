{
    "files.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.idea": true,
        "**/.ruff_cache": true
    },
    "search.exclude": {
        "**/uv.lock": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "pyproject.toml": "uv.lock, .python-version",
    },
    "cSpell.words": [
        "Ahmadi",
        "Ehsan",
        "fstring",
        "kwargs"
    ]
}
